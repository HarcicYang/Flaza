{
  "edit_predictions": {
    "provider": "none"
  },
  "show_edit_predictions": false,
  "languages": {
    "Python": {
      "language_servers": ["pyrefly", "ruff", "!basedpyright", "!pyright", "!pylsp"],
      "code_actions_on_format": {
        "source.organizeImports.ruff": true
      },
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      }
    }
  },
  "lsp": {
    "pyrefly": {
      "binary": {
        "path": ".venv/bin/pyrefly",
        "arguments": ["lsp"]
      },
      "settings": {
        "python": {
          "pythonPath": ".venv/bin/python"
        },
        "pyrefly": {
          "project_includes": ["src/**/*.py", "tests/**/*.py", "main.py"],
          "search_path": ["src"]
        }
      }
    }
  }
}
